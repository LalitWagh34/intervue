# Production Environment Variables for Render / Railway Backend (apps/server)

PORT=3000
NODE_ENV=production

# 1. Neon PostgreSQL Database connection string (from Neon console)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.aws.neon.tech/neondb?sslmode=require

# 2. Better Auth Secrets & URLs
BETTER_AUTH_SECRET=generate_a_random_32_char_secret_or_let_render_generate
# Deployed Render Backend domain:
BETTER_AUTH_URL=https://intervue-backend.onrender.com

# 3. Deployed Vercel Frontend domain (for CORS & secure cross-site cookies)
FRONTEND_URL=https://your-intervue-frontend.vercel.app
CLIENT_URL=https://your-intervue-frontend.vercel.app

# 4. AI & Groq API
GROQ_API_KEY=gsk_your_groq_api_key

# 5. Judge0 Code Execution
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# 6. Email / Feedback (Resend)
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=your_email@gmail.com

# 7. Google OAuth (Optional: add your production Vercel callback URL to Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
